# --- Anthropic Managed Agent (the coach brain) ---
ANTHROPIC_API_KEY=sk-ant-change_me
# No fixed session id: each inbound message is routed to the session resolved for
# its athlete by phone_num (in Neon). See @inigo/db and the routeInboundMessage use-case.

# --- WhatsApp webhook (OpenWA) ---
# Optional: shared secret to verify the X-OpenWA-Signature HMAC.
# If left empty, signature verification is skipped (MVP relies on a non-guessable
# URL + the gateway's "Sender is …" filter). Min 16 chars when set.
WHATSAPP_WEBHOOK_SECRET=

# --- Database (Neon Postgres, shared coaching DB via @inigo/db) ---
# Neon connection string. Server-side only.
# These two must be HERE, in apps/coach/.env: Next only reads the .env of the app it
# runs from. packages/db/.env is a different file, used solely by drizzle-kit for the
# migration commands — the coach app never reads it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Base64-encoded 32-byte key for AES-256-GCM sealing of per-athlete secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DB_ENCRYPTION_KEY=

# --- MCP endpoints (the brain reads/writes here) ---
# Bearer token the brain must present at all three MCP servers:
# /api/coaching-data/mcp, /api/intervals/mcp and /api/whatsapp/mcp.
# Min 16 chars, server-side only.
MCP_BEARER_TOKEN=

# --- Intervals.icu MCP (/api/intervals/mcp) ---
# Optional override of the Intervals.icu API base URL. Defaults to
# https://intervals.icu/api/v1. Each athlete's own key is resolved from Neon at
# request time (athlete_credential), so no global Intervals key lives here.
INTERVALS_BASE_URL=

# --- WhatsApp MCP (/api/whatsapp/mcp — the agent's only way to reply) ---
# Credentials of the OpenWA gateway the coach relays messages to. Needed to SEND, and
# only that: they are read where they are used, never by the shared config schema, so a
# missing value degrades /api/whatsapp/mcp alone and leaves the webhook, the two other
# MCP servers and the admin untouched.
OPENWA_BASE_URL=https://whatsapp.inigo-coach.com
# OPERATOR-role API key (owa_k1_…).
OPENWA_API_KEY=
# No OPENWA_SESSION_ID here on purpose: the gateway session changes every time WhatsApp is
# re-paired (session dropped, QR rescanned), so it lives in Neon and is set from /admin.
# Restoring the coach's voice must not need a redeploy.

# --- Admin (/admin + /api/admin/*) ---
# HTTP Basic credentials guarding the admin. Needed to USE the admin, and only that:
# they are read where they are used, never by the shared config schema, so a missing or
# too-short value disables the admin (503) without touching the WhatsApp webhook or the
# MCP endpoints. ADMIN_USER min 3 chars, ADMIN_PASSWORD min 16.
ADMIN_USER=inigo
ADMIN_PASSWORD=
