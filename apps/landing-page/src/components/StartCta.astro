---
import { start, whatsappContact } from "@/content/copy";
import { whatsappLink } from "@/lib/whatsapp-link";

/**
 * CTA principal. Sur mobile il ouvre WhatsApp, message prérempli (la conversation se vit dans
 * l'app native) ; sur desktop il descend vers le QR de « Démarrer », pour passer au téléphone.
 * Bascule en CSS (breakpoint lg), sans JS. Les wrappers `contents` laissent le lien se placer
 * dans la mise en page du parent.
 */
interface Props {
  label: string;
  class: string;
}

const { label, class: className } = Astro.props;
const url = whatsappLink(whatsappContact.phoneNumber, start.message);
---

<span class="contents lg:hidden">
  <a href={url} rel="noopener" class={className}>{label}</a>
</span>
<span class="hidden lg:contents">
  <a href="#demarrer" class={className}>{label}</a>
</span>
