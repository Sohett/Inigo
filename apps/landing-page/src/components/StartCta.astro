---
import { whatsappContact } from "@/content/copy";
import { whatsappLink } from "@/lib/whatsapp-link";

/**
 * CTA principal. Sur mobile il ouvre WhatsApp, message prérempli (la conversation se vit dans
 * l'app native) ; sur desktop il descend vers le QR de « Démarrer », pour passer au téléphone.
 * Bascule en CSS (breakpoint lg), sans JS.
 */
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = "pill pill-dark" } = Astro.props;
const url = whatsappLink(whatsappContact.phoneNumber, whatsappContact.message);
---

<a href={url} rel="noopener" class:list={[className, "lg:hidden"]}><span class="wa-dot"></span>{label}</a>
<a href="#start" class:list={[className, "max-lg:hidden"]}><span class="wa-dot"></span>{label}</a>
