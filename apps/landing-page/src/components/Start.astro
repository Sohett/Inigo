---
import WhatsAppQr from "@/components/WhatsAppQr.astro";
import { footer, start, whatsappContact } from "@/content/copy";
import { whatsappLink } from "@/lib/whatsapp-link";

/** Démarrer (QR sur desktop, WhatsApp direct sur mobile) et footer, sur la bande sombre finale. */
const url = whatsappLink(whatsappContact.phoneNumber, whatsappContact.message);
const [firstStep, ...otherSteps] = start.steps;
---

<section class="start dark band" id="start">
  <div class="wrap start-grid">
    <div class="stack reveal" style="gap:26px">
      <span class="mono">{start.eyebrow}</span>
      <h2 class="display-1">{start.title}</h2>
      <ol class="steps">
        <li>
          <span class="mono">01</span>
          <span class="only-desktop"><b>{firstStep?.title}</b> {firstStep?.body}</span>
          <span class="only-mobile"><b>{start.mobileFirstStep.title}</b> {start.mobileFirstStep.body}</span>
        </li>
        {
          otherSteps.map((step, index) => (
            <li>
              <span class="mono">{String(index + 2).padStart(2, "0")}</span>
              <span>
                <b>{step.title}</b> {step.body}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="reveal" style="--delay:100ms">
      <div class="qr-panel only-desktop">
        <WhatsAppQr label={start.qr.alt} />
        <span class="mono with-dot"><span class="wa-dot"></span>{start.qr.title}</span>
        <p>{start.qr.body}</p>
        <a class="pill dark" href={url} target="_blank" rel="noopener"><span class="wa-dot"></span>{start.desktopLink}</a>
      </div>
      <a class="pill light only-mobile" href={url} rel="noopener" style="width:100%"
        ><span class="wa-dot"></span>{start.mobileCta}</a
      >
    </div>
  </div>
  <footer class="wrap site-footer">
    <span class="mono">{footer.copyright}</span>
    <nav class="mono" aria-label={footer.navLabel}>
      <a href="/confidentialite">{footer.privacy}</a>
      <a href={`mailto:${footer.contactEmail}`}>{footer.contact}</a>
    </nav>
  </footer>
</section>
