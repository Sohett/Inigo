---
import QRCode from "qrcode";
import { start, whatsappContact } from "@/content/copy";
import { whatsappLink } from "@/lib/whatsapp-link";

const url = whatsappLink(whatsappContact.phoneNumber, start.message);
// QR généré au build depuis le lien : il suit le numéro et le message, zéro JS côté client.
const qrSvg = await QRCode.toString(url, {
  type: "svg",
  margin: 0,
  errorCorrectionLevel: "M",
  color: { dark: "#0E1116", light: "#0000" },
});
---

<section id="demarrer" class="scroll-mt-20 bg-secondary/40 px-6">
  <div class="mx-auto max-w-xl py-24 sm:py-32">
    <div class="reveal text-center">
      <p class="eyebrow text-encre-soft">{start.eyebrow}</p>
      <h2 class="mt-5 text-3xl font-bold sm:text-4xl">{start.title}</h2>
      <p class="mt-4 text-muted-foreground">{start.subtitle}</p>
    </div>

    {/* Mobile : le bouton ouvre WhatsApp directement. */}
    <div class="reveal mt-10 lg:hidden" style="--delay:100ms">
      <a
        href={url}
        rel="noopener"
        class="flex h-14 w-full items-center justify-center rounded-xl bg-encre px-6 text-base font-semibold text-white transition hover:bg-encre/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-encre focus-visible:ring-offset-2 focus-visible:ring-offset-background"
      >
        {start.cta}
      </a>
    </div>

    {/* Desktop : le QR en avant, pour que la conversation se fasse sur le téléphone. */}
    <div
      class="reveal mt-10 hidden flex-col items-center rounded-2xl border border-border bg-card p-8 text-center shadow-sm lg:flex"
      style="--delay:100ms"
    >
      <div class="size-52 [&_svg]:size-full" role="img" aria-label={start.qr.alt} set:html={qrSvg} />
      <h3 class="mt-6 font-display text-lg font-semibold">{start.qr.title}</h3>
      <p class="mt-2 max-w-sm text-sm leading-relaxed text-muted-foreground">{start.qr.body}</p>
      <a
        href={url}
        target="_blank"
        rel="noopener"
        class="mt-6 text-sm text-encre-soft underline underline-offset-4 transition hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-encre/40"
      >
        {start.desktopLink}
      </a>
    </div>
  </div>
</section>
