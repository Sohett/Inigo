---
import { analysis } from "@/content/copy";
---

<section class="sec band" id="analyse">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="l">
        <span class="mono">{analysis.eyebrow}</span>
        <h2 class="display-2">{analysis.title}</h2>
      </div>
      <p class="r">{analysis.body}</p>
    </div>

    <div class="session-card reveal">
      <div class="row-between">
        <span class="mono ink">{analysis.session}</span><span class="mono">{analysis.sessionStats}</span>
      </div>
      {/* Séance illustrative : puissance (noir) face à la cible (or), FC en pointillés. */}
      <svg class="session-chart" viewBox="0 0 640 210" role="img" aria-label={analysis.chartAriaLabel}>
        <g stroke="#1c1c1c0d"><line x1="0" y1="50" x2="640" y2="50"></line><line x1="0" y1="110" x2="640" y2="110"></line><line x1="0" y1="170" x2="640" y2="170"></line></g>
        <rect x="105" y="45" width="84" height="10" fill="#f0dcae"></rect>
        <rect x="217" y="45" width="84" height="10" fill="#f0dcae"></rect>
        <rect x="329" y="45" width="84" height="10" fill="#f0dcae"></rect>
        <polyline
          points="0,124 40,116 70,112 105,110 108,50 150,49 189,50 192,116 217,116 220,50 260,51 301,50 304,116 329,116 332,48 352,50 372,55 392,59 413,63 416,118 504,120 560,124 640,128"
          fill="none"
          stroke="#0d0d0d"
          stroke-width="2"></polyline>
        <polyline
          points="0,160 105,150 189,128 217,140 301,127 329,138 413,126 504,146 640,156"
          fill="none"
          stroke="#e9705c"
          stroke-width="1.5"
          stroke-dasharray="4 3"></polyline>
        <g font-family="IBM Plex Mono, monospace" font-size="11" fill="#787873">
          <text x="4" y="44">{analysis.axis.high}</text><text x="4" y="104">{analysis.axis.low}</text><text x="600" y="200">{analysis.axis.end}</text>
        </g>
        <g font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600">
          <circle cx="147" cy="28" r="10" fill="#0d0d0d"></circle><text x="143.5" y="32" fill="#fffdf9">1</text>
          <circle cx="259" cy="28" r="10" fill="#0d0d0d"></circle><text x="255.5" y="32" fill="#fffdf9">2</text>
          <circle cx="392" cy="28" r="10" fill="#ea580c"></circle><text x="388.5" y="32" fill="#ffffff">3</text>
        </g>
      </svg>
      <div class="line-legend">
        <span class="mono"><i style="background:#0d0d0d"></i>{analysis.legend.power}</span>
        <span class="mono"><i style="background:#e9705c"></i>{analysis.legend.heartRate}</span>
        <span class="mono"><i style="background:#f0dcae;height:8px"></i>{analysis.legend.target}</span>
      </div>
      <div class="notes">
        {
          analysis.notes.map((note) => (
            <div class:list={{ "is-highlight": note.highlight }}>
              <span class="mono ink">{note.label}</span>
              <p>{note.body}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="tbl-wrap reveal">
      <table>
        <caption class="sr-only">{analysis.comparison.caption}</caption>
        <thead>
          <tr><td></td>{analysis.comparison.headers.map((header) => <th scope="col">{header}</th>)}</tr>
        </thead>
        <tbody>
          {
            analysis.comparison.rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {row.values.map((value, index) => (
                  <td class:list={{ us: index === row.values.length - 1 }}>{value}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
