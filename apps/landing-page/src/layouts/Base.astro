---
import "../styles/global.css";
import { meta, nav } from "@/content/copy";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
}

// Image de partage : changer de nom de fichier à chaque refonte, les réseaux la gardent en cache par URL.
const { title = meta.title, description = meta.description, ogImage = "/og-v3.png", bodyClass } = Astro.props;

const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin).toString();
const ogImageUrl = new URL(ogImage, origin).toString();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fffdf9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {/* Marque le JS actif : seul ce cas active l'effet de reveal (sinon contenu visible). */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={meta.ogImageAlt} />
  </head>
  <body class={bodyClass}>
    <a href="#contenu" class="pill pill-dark sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-4 focus:z-50">{nav.skipLink}</a>
    <slot />
  </body>
</html>
