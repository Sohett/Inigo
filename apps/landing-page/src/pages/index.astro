---
import Base from "@/layouts/Base.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Hero from "@/components/Hero.astro";
import PlanLive from "@/components/PlanLive.astro";
import Coach from "@/components/Coach.astro";
import Analysis from "@/components/Analysis.astro";
import Science from "@/components/Science.astro";
import RaceDay from "@/components/RaceDay.astro";
import Pricing from "@/components/Pricing.astro";
import Start from "@/components/Start.astro";
import MobileBar from "@/components/MobileBar.astro";
import { goals, scenarios } from "@/content/demo";
import { planDemo } from "@/lib/plan-demo";

// État initial de la démo (rendu au build) : premier objectif, premier imprévu.
const initialDemo = planDemo(goals[0]?.id ?? "triathlon-l", scenarios[0]?.id ?? "bad-night");
---

<Base bodyClass="max-md:pb-20">
  <SiteHeader />
  <main id="contenu">
    <Hero demo={initialDemo} />
    <PlanLive demo={initialDemo} />
    <Coach />
    <Analysis />
    <Science />
    <RaceDay />
    <Pricing />
    <Start />
  </main>
  <MobileBar />
</Base>

<script>
  import { startDemo } from "@/lib/demo-controller";

  startDemo();

  // Reveal au scroll, une seule fois ; respecte prefers-reduced-motion et l'absence d'IO.
  const elements = document.querySelectorAll<HTMLElement>(".reveal");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (reduce || !("IntersectionObserver" in window)) {
    elements.forEach((el) => el.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
    );
    elements.forEach((el) => observer.observe(el));
  }
</script>
